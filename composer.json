{
    "name": "dominaite/merchant-sdk",
    "description": "Server-side PHP client for the Dominaite merchant API: create hosted checkout sessions from your own backend.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "psr/log": "Pass a PSR-3 LoggerInterface as the logger option to receive the SDK's warnings and debug lines"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Dominaite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dominaite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "php tests/vectors.php",
            "php tests/webhook_vectors.php",
            "php tests/idempotency_vectors.php",
            "php tests/redaction_vectors.php",
            "php tests/contract_vectors.php",
            "php tests/wire_contract_vectors.php",
            "php tests/payment_method_vectors.php",
            "php tests/hardening_vectors.php",
            "php tests/transport_vectors.php",
            "php tests/helper_vectors.php",
            "php tests/refund_vectors.php",
            "php tests/recurring_vectors.php",
            "php tests/reporting_vectors.php",
            "php tests/lenient_vectors.php",
            "php tests/usage_vectors.php"
        ]
    }
}
